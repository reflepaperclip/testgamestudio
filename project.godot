;   param=value ; assign values to parameters

config_version=5

[application]

run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")

[config]

name="Modern Military Stealth"
description="A top-down stealth shooter set in modern military tactical environment"
author="대표 (CEO)"
version_major=1
version_minor=0
version_patch=0

[rendering]

quality/driver/driver_name="vulkan"
